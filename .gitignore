# Python bytecode and interpreter caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Packaging and build output
build/
dist/
*.egg-info/
*.egg

# Test, coverage, and tooling caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.pyre/
.pytype/
.ruff_cache/
.hypothesis/

# Local environment variables and secrets
.env
.env.*
!.env.example
!.env.sample

# Local databases, logs, and runtime files
*.db
*.sqlite
*.sqlite3
*.log
*.pid

# Editors and operating-system metadata
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini

# Temporary files
*.tmp
*.temp
*.bak
*.orig
~$*
